{
  "name": "ra-input-markdown",
  "version": "2.0.1",
  "description": "A Markdown input (<MarkdownInput>) for react-admin, built on @uiw/react-md-editor.",
  "main": "lib/index.js",
  "module": "esm/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "esm",
    "NOTICE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/maluramichael/ra-input-markdown.git"
  },
  "keywords": [
    "react-admin",
    "markdown",
    "input",
    "react",
    "admin-on-rest"
  ],
  "author": "Michael Malura <github@malura.de>",
  "license": "Apache-2.0",
  "scripts": {
    "build": "npm run build-cjs && npm run build-esm",
    "build-cjs": "rimraf ./lib && tsc",
    "build-esm": "rimraf ./esm && tsc --outDir esm --module es2015 --moduleResolution bundler",
    "watch": "rimraf ./lib && tsc --watch",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "test:watch": "NODE_OPTIONS=--no-experimental-webstorage vitest"
  },
  "dependencies": {
    "@uiw/react-md-editor": "^4.0.0"
  },
  "overrides": {
    "decode-uri-component": "^0.5.0"
  },
  "peerDependencies": {
    "@mui/material": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-admin": "^5.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@mui/material": "^7.0.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.0",
    "react": "^19.0.0",
    "react-admin": "^5.0.0",
    "react-dom": "^19.0.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.2"
  }
}
